# Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional.
# Set this to either:
# - the folder containing ffmpeg.exe and ffprobe.exe
# - the full path to ffmpeg.exe
#
# If left blank or invalid, the app will try bundled ffmpeg first, then system PATH.
FFMPEG_PATH=